# ApnaStay Environment Configuration Example
DEBUG=True
SECRET_KEY=replace-with-a-secure-random-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
# Set USE_POSTGRES=True when your local or production PostgreSQL database is running.
# If PostgreSQL is not reachable, ApnaStay automatically falls back to SQLite for development.
USE_POSTGRES=False
DB_NAME=apnastay_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
